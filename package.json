{
  "name": "code-divider",
  "version": "1.0.0",
  "description": "Format separator/header comment markers so labels are centered and each line fills up to a character limit.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seanpmaxwell/code-divider.git"
  },
  "homepage": "https://github.com/seanpmaxwell/code-divider#readme",
  "bugs": "https://github.com/seanpmaxwell/code-divider/issues",
  "author": "Sean Maxwell",
  "bin": {
    "code-divider": "bin/cli.js"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "imports": {
    "#src/*": "./src/*",
    "#scripts/*": "./scripts/*"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "files": [
    "bin",
    "lib",
    "README.md"
  ],
  "scripts": {
    "build": "tsx scripts/build.ts",
    "commit": "tsx scripts/commit.ts",
    "commit:push": "tsx scripts/commit.ts -p",
    "start": "npm run build && node bin/cli.js",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "readme:swap": "mv README.md README.tmp.md && mv README-npm.md README.md",
    "readme:restore": "mv README.md README-npm.md && mv README.tmp.md README.md",
    "prepare": "tsx scripts/esbuild.ts",
    "prepublishOnly": "tsc && npm run lint && npm run format:check && npm test && npm run readme:swap",
    "postpack": "npm run readme:restore",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "typecheck": "tsc"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "cli",
    "formatter",
    "comments",
    "divider",
    "dividers",
    "code-divider",
    "code-dividers",
    "separators",
    "separator",
    "headers",
    "header",
    "comment-headers",
    "code-comments",
    "region",
    "section",
    "banner",
    "divider",
    "code-formatting",
    "source-code"
  ],
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "execa": "^10.0.1",
    "globals": "^17.7.0",
    "jiti": "^2.7.0",
    "prettier": "^3.9.5",
    "tsx": "^4.23.11",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}

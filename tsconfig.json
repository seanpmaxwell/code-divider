{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],

    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,

    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,

    "noEmit": true,

    "paths": {
      "@src": ["./src/index.ts"],
      "@common/*": ["./src/_common/*"],
      "@logger": ["./src/_common/utils/logger.ts"],
      "@FileUtils": ["./src/_common/utils/FileUtils"]
    }
  },
  "include": ["src", "test", "eslint.config.ts", "playground", "scripts"],
  "exclude": ["node_modules", "lib", "bin"]
}

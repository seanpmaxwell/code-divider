{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],

    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,

    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,

    "noEmit": true,

    "paths": {
      "@src/*": ["./src/*"],
      "@logger": ["./src/common/utils/logger.ts"]
    }
  },
  "include": ["src", "test", "./*.config.ts", "playground"],
  "exclude": ["node_modules", "lib", "bin"]
}

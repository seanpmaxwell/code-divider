{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],

    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,

    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,

    "noEmit": true,

    "paths": {
      "@src/*": ["./src/*"],
      "@common/*": ["./src/_common/*"],
      "@utilm/*": ["./src/_common/utils/modules/*"],
      "@logger": ["./src/_common/utils/modules/logger"],
      "@shell": ["./src/_common/utils/fns/shell"],
      "@test/*": ["./test/*"]
    }
  },
  "include": [
    "src",
    "test",
    "*.config.ts",
    "playground",
    "scripts",
    "demo-studio"
  ],
  "exclude": [
    "node_modules",
    "lib",
    "bin",
    "playground/tmp",
    "playground/templates"
  ]
}
